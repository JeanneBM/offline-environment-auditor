{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"namespace": "example", "name": "legacy-api"},
      "spec": {
        "template": {
          "spec": {
            "hostNetwork": true,
            "containers": [
              {
                "name": "api",
                "image": "internal.invalid/example:latest",
                "securityContext": {
                  "privileged": true,
                  "capabilities": {"add": ["SYS_ADMIN"]}
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {"namespace": "example", "name": "broad-role"},
      "rules": [{"apiGroups": ["*"], "resources": ["*"], "verbs": ["*"]}]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {"name": "review-admin-binding"},
      "roleRef": {"apiGroup": "rbac.authorization.k8s.io", "kind": "ClusterRole", "name": "cluster-admin"},
      "subjects": [{"kind": "ServiceAccount", "name": "automation", "namespace": "example"}]
    }
  ]
}
